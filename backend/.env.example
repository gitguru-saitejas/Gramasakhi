# =============================================================================

# GramSakhi backend — copy to backend/.env and fill secrets

# Demo contract: Supabase Postgres + nomic-embed-text (768) + Ollama LLM

# =============================================================================



# Prefer Supabase Postgres for Phase 2 review / shared knowledge.

# Local-only alternate: DATABASE_URL=sqlite:///./gramsakhi.db

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres



# JWT signing (change in every environment)

SECRET_KEY=change_me_to_a_long_random_string



# Application environment — use "production" in deployed environments

APP_ENV=development

# CORS (JSON array or comma-separated). Defaults include local Vite + https://gramasakhi-1.onrender.com
# BACKEND_CORS_ORIGINS=["https://gramasakhi-1.onrender.com","http://127.0.0.1:5173"]

# Supabase Storage (service_role required for private bucket writes)

SUPABASE_URL=https://YOUR_PROJECT.supabase.co

SUPABASE_PUBLISHABLE_KEY=

# Secret / service_role — never commit real keys

SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_STORAGE_BUCKET=rag-documents



# RAG Embedding — MUST match document_chunks.embedding vector size in schema

# local = Ollama embeddings OK; cloud = Gemini only (see RUNTIME_PROFILE)
RUNTIME_PROFILE=local

EMBEDDING_PROVIDER=ollama

EMBEDDING_MODEL=nomic-embed-text

EMBEDDING_DIMENSIONS=768

# When EMBEDDING_PROVIDER=gemini (required for RUNTIME_PROFILE=cloud):
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_TIMEOUT_SECONDS=60
GEMINI_EMBEDDING_BATCH_SIZE=16
GEMINI_EMBEDDING_MAX_RETRIES=1

OLLAMA_API_URL=http://127.0.0.1:11434

OLLAMA_BASE_URL=http://127.0.0.1:11434

OLLAMA_LLM_MODEL=llama3.2:3b

OLLAMA_MODEL=llama3.2:3b

OLLAMA_LLM_TEMPERATURE=0.1

OLLAMA_LLM_TIMEOUT_SECONDS=60

OLLAMA_LLM_NUM_PREDICT=512

# LLM text generation (RAG answers, eligibility phrasing, translation/rephrase)
# Recommended for lower local GPU/RAM: gemini. Embeddings still use Ollama above.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# Verify model id for your account: https://ai.google.dev/gemini-api/docs/models
# New projects: gemini-3.5-flash-lite or gemini-3.8-flash (free-tier quotas vary).
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.1
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_OUTPUT_TOKENS=512
GEMINI_MAX_RETRIES=1
LLM_FALLBACK_TO_OLLAMA=true
# Cloud production: RUNTIME_PROFILE=cloud, LLM_FALLBACK_TO_OLLAMA=false

# Use local Ollama for generation instead:
# LLM_PROVIDER=ollama



# Hybrid RAG indexes (FAISS + BM25 + CrossEncoder) — relative to backend/

HYBRID_INDEX_DIR=indexes

HYBRID_FAISS_WEIGHT=0.6

HYBRID_BM25_WEIGHT=0.4

HYBRID_CANDIDATE_K=20

HYBRID_TOP_K=5

HYBRID_RERANK_ENABLED=true
# Render Free / low RAM: set false so CrossEncoder loads on first query, not at startup
STARTUP_WARM_CROSS_ENCODER=true

CROSS_ENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2



# Evidence sufficiency hard gate

EVIDENCE_GATE_ENABLED=true

EVIDENCE_RELEVANCE_THRESHOLD=0.65

EVIDENCE_COVERAGE_THRESHOLD=0.6

EVIDENCE_AGREEMENT_THRESHOLD=0.7

EVIDENCE_AGREEMENT_VARIANCE_MAX=0.08

EVIDENCE_MIN_QUERY_TERMS=2

EVIDENCE_DOC_FLOOR=0.5

QUERY_EMBED_CACHE_SIZE=256



# Conversation + query rewriting

CONVERSATION_HISTORY_LIMIT=6

QUERY_REWRITE_USE_OLLAMA=false

QUERY_REWRITE_TIMEOUT_SECONDS=15



# Live government retrieval fallback

LIVE_GOV_FALLBACK_ENABLED=true

LIVE_GOV_MAX_SOURCES=4

LIVE_GOV_MAX_CANDIDATES=8

LIVE_GOV_MAX_PDFS=4

LIVE_GOV_MAX_PAGES=6

LIVE_GOV_MAX_DOCUMENTS=6

LIVE_GOV_MAX_PDF_SIZE_MB=10

LIVE_GOV_TIMEOUT_SECONDS=25

LIVE_GOV_OVERALL_TIMEOUT_SECONDS=240

LIVE_GOV_BROWSER_ENABLED=true

LIVE_GOV_BROWSER_TIMEOUT_SECONDS=45

LIVE_GOV_MAX_BROWSER_ACTIONS=8

LIVE_GOV_OCR_TIMEOUT_SECONDS=60

LIVE_GOV_PROVIDER_REGISTRY_ENABLED=true

INDIAGOV_PROVIDER_ENABLED=true

DATAGOV_PROVIDER_ENABLED=true



# Voice STT/TTS (optional; text chat works if unavailable)

STT_ENABLED=true

STT_MODEL=base

STT_DEVICE=cpu

STT_COMPUTE_TYPE=int8

STT_MAX_AUDIO_SIZE_MB=8

STT_MAX_DURATION_SECONDS=60

STT_TIMEOUT_SECONDS=90

STT_MIN_CONFIDENCE=0.35

STT_MAX_CONCURRENT=2

TTS_ENABLED=true

TTS_MODEL=edge-tts

TTS_VOICE_EN=en-IN-NeerjaNeural

TTS_VOICE_KN=kn-IN-SapnaNeural

TTS_VOICE_HI=hi-IN-SwaraNeural

TTS_DEVICE=cpu

TTS_TIMEOUT_SECONDS=60

TTS_MAX_CONCURRENT=2

TTS_CACHE_ENABLED=true

TTS_CACHE_MAX_ENTRIES=64

VOICE_RATE_LIMIT_WINDOW_SECONDS=60

VOICE_RATE_LIMIT_PER_WINDOW=30



# Auth abuse controls (H7-A)

AUTH_RATE_LIMIT_WINDOW_SECONDS=3600

AUTH_OTP_SEND_MAX_PER_WINDOW=5

AUTH_RATE_LIMIT_MAX_PER_WINDOW=30

# OTP console simulator: full codes only on SQLite dev; set false in production

OTP_CONSOLE_SIMULATOR_ENABLED=true

# OTP delivery — dev_popup shows code in API + UI side panel (FYP demo); sms = no OTP in API
OTP_DELIVERY_MODE=dev_popup
OTP_DEV_POPUP_ENABLED=true
# Production must use: OTP_DELIVERY_MODE=sms and OTP_DEV_POPUP_ENABLED=false

# Dev-only OTP retrieval endpoint — manual testing; never enable in production

OTP_DEV_RETRIEVAL_ENABLED=false

OTP_DEV_RETRIEVAL_KEY=

SECURITY_HEADERS_ENABLED=true



# IVR — Exotel telephony (A1 language selection; configure Flow in Exotel dashboard)

IVR_PROVIDER=mock

EXOTEL_ACCOUNT_SID=

EXOTEL_API_KEY=

EXOTEL_API_TOKEN=

# IVR-A3 — dedicated CitizenAccount for telephony chat bridge (never expose to caller)

IVR_CITIZEN_ACCOUNT_ID=

IVR_SYSTEM_ACCOUNT_PHONE=

# IVR-A4 — public HTTPS base for Exotel audio fetch (never use request Host in production)

IVR_PUBLIC_BASE_URL=
IVR_MAX_TURNS=10
IVR_SESSION_TTL_SECONDS=1800
IVR_MAX_ACTIVE_SESSIONS=1000
IVR_MAX_ACTIVE_AUDIO_TOKENS=2000
IVR_RATE_LIMIT_MAX_KEYS=4096
IVR_WEBHOOK_SHARED_SECRET=
# Prefer the X-GramSakhi-Ivr-Secret header; set false in production so the secret
# never appears in query strings (proxy/access logs).
IVR_WEBHOOK_SECRET_ALLOW_QUERY=true
# Only enable when a trusted reverse proxy sets X-Forwarded-For.
IVR_TRUST_PROXY_HEADERS=false
# POST /api/ivr/transcribe (direct audio upload) is dev/test only; production
# returns 404 unless this is explicitly true.
IVR_DIRECT_UPLOAD_IN_PRODUCTION=false
# Spec-name alias for the audio token TTL; when > 0 it overrides
# IVR_AUDIO_TOKEN_TTL_SECONDS (kept for backward compatibility).
IVR_PUBLIC_AUDIO_TOKEN_TTL=0



# Optional web ingest scheduler (disabled by default)

WEB_INGEST_SCHEDULER_ENABLED=false

WEB_INGEST_INTERVAL_HOURS=168

WEB_INGEST_SOURCE=central

WEB_INGEST_MAX_DOCS=3

