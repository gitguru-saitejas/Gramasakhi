__pycache__/
**/__pycache__/
*.pyc
*.pyo
.venv/
venv/
.pytest_cache/
.coverage
coverage/
htmlcov/

# Local dev OTP mirror (never commit)
backend/.dev_otp_last.txt

# Local databases
*.db
*.sqlite
*.sqlite3

# Generated retrieval artifacts, uploads, caches
backend/indexes/
backend/test_hybrid_indexes/
backend/tmp_e2e_indexes/
