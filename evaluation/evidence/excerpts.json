      "field": "benefits",
      "section": "benefits",
      "kind": "bullet",
      "line_start": 24,
      "line_end": 24,
      "excerpt": "Zero fare for eligible women passengers on notified routes and participating bus services.",
      "source_url": null
    },
    {
      "id": "seed-shakti-013",
      "scheme_id": "shakti",
      "document_id": "seed-shakti",
      "document_path": "backend/data/demo_seeds/shakti_scheme.txt",
      "field": "benefits",
      "section": "benefits",
      "kind": "bullet",
      "line_start": 25,
      "line_end": 26,
      "excerpt": "Applies to ordinary / notified categories of state buses as per the government order; premium or excluded services (if any) follow the latest official notification.",
      "source_url": null
    },
