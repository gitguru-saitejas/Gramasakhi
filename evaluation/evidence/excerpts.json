      "document_id": "seed-shakti",
      "document_path": "backend/data/demo_seeds/shakti_scheme.txt",
      "field": "purpose",
      "section": "purpose",
      "kind": "paragraph",
      "line_start": 8,
      "line_end": 12,
      "excerpt": "The Shakti scheme provides free travel for eligible women passengers on participating\nstate-run bus services in Karnataka. It is a state government welfare scheme intended\nto improve women's mobility and access to education, work, and essential services.",
      "source_url": null
    },
    {
      "id": "seed-shakti-007",
      "scheme_id": "shakti",
      "document_id": "seed-shakti",
      "document_path": "backend/data/demo_seeds/shakti_scheme.txt",
      "field": "eligibility",
      "section": "eligibility",
      "kind": "bullet",
      "line_start": 14,
      "line_end": 14,
      "excerpt": "Women citizens of Karnataka are the intended beneficiaries for free travel under the scheme.",
      "source_url": null
    },
    {
      "id": "seed-shakti-008",
      "scheme_id": "shakti",
      "document_id": "seed-shakti",
      "document_path": "backend/data/demo_seeds/shakti_scheme.txt",
      "field": "eligibility",
      "section": "eligibility",
      "kind": "bullet",
      "line_start": 15,
      "line_end": 16,
      "excerpt": "Travel is available on participating Karnataka State Road Transport Corporation (KSRTC) and other notified state transport buses as per government notifications.",
      "source_url": null
    },
    {
      "id": "seed-shakti-009",
      "scheme_id": "shakti",
      "document_id": "seed-shakti",
      "document_path": "backend/data/demo_seeds/shakti_scheme.txt",
      "field": "eligibility",
      "section": "eligibility",
      "kind": "bullet",
      "line_start": 17,
      "line_end": 18,
      "excerpt": "Beneficiaries should follow the latest official rules for proof of identity when required by conductors or transport authorities.",
      "source_url": null
    },
    {
      "id": "seed-shakti-010",
      "scheme_id": "shakti",
      "document_id": "seed-shakti",
      "document_path": "backend/data/demo_seeds/shakti_scheme.txt",
      "field": "eligibility",
      "section": "eligibility",
      "kind": "bullet",
      "line_start": 19,
      "line_end": 19,
      "excerpt": "Men are not eligible for free travel under this scheme.",
      "source_url": null
    },
    {
      "id": "seed-shakti-011",
      "scheme_id": "shakti",
      "document_id": "seed-shakti",
      "document_path": "backend/data/demo_seeds/shakti_scheme.txt",
      "field": "eligibility",
      "section": "eligibility",
      "kind": "bullet",
      "line_start": 20,
      "line_end": 21,
      "excerpt": "Rules for children, special categories, and exclusions are as notified by the Transport Department from time to time.",
      "source_url": null
    },
    {
      "id": "seed-shakti-012",
      "scheme_id": "shakti",
      "document_id": "seed-shakti",
