      "id": "seed-shakti-014",
      "scheme_id": "shakti",
      "document_id": "seed-shakti",
      "document_path": "backend/data/demo_seeds/shakti_scheme.txt",
      "field": "procedure",
      "section": "procedure",
      "kind": "bullet",
      "line_start": 29,
      "line_end": 30,
