    {
      "id": "seed-pmfby-006",
      "scheme_id": "pmfby",
      "document_id": "seed-pmfby",
      "document_path": "backend/data/demo_seeds/pmfby_scheme.txt",
      "field": "purpose",
      "section": "purpose",
      "kind": "paragraph",
      "line_start": 8,
      "line_end": 12,
      "excerpt": "PMFBY provides crop insurance cover to farmers against yield losses due to non-preventable\nnatural risks such as drought, flood, pest attack, and other notified perils, as defined\nin the scheme guidelines for the insured season and crop.",
      "source_url": null
    },
    {
      "id": "seed-pmfby-007",
      "scheme_id": "pmfby",
      "document_id": "seed-pmfby",
      "document_path": "backend/data/demo_seeds/pmfby_scheme.txt",
      "field": "eligibility",
      "section": "eligibility",
      "kind": "bullet",
      "line_start": 14,
      "line_end": 15,
      "excerpt": "All farmers growing notified crops in notified areas can enroll, including loanee and non-loanee farmers, subject to state / season notifications.",
      "source_url": null
    },
    {
      "id": "seed-pmfby-008",
      "scheme_id": "pmfby",
      "document_id": "seed-pmfby",
      "document_path": "backend/data/demo_seeds/pmfby_scheme.txt",
      "field": "eligibility",
      "section": "eligibility",
      "kind": "bullet",
      "line_start": 16,
      "line_end": 17,
      "excerpt": "Enrollment is typically done through banks, Common Service Centres (CSCs), insurance company channels, or the PMFBY portal as notified for the season.",
      "source_url": null
    },
    {
