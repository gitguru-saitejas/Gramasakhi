      "field": "eligibility",
      "section": "eligibility",
      "kind": "bullet",
      "line_start": 18,
      "line_end": 18,
      "excerpt": "Coverage applies only for crops and areas notified for that season by the state government.",
      "source_url": null
    },
    {
